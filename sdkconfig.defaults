CONFIG_IDF_TARGET="esp32s3"

# CPU Clock Frequency: Max 240 MHz for ultra-fast responsiveness
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compiler optimization for performance (-O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ESP32-S3 Flash configuration: 80MHz DIO
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# FreeRTOS 1000Hz tick rate (1ms resolution)
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# USB Host Configuration
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
