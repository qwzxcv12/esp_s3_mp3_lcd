CONFIG_IDF_TARGET="esp32s3"

# CPU Clock Frequency: Max 240 MHz for ultra-fast responsiveness
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compiler optimization for performance (-O2)
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ESP32-S3 Flash configuration: 16MB Flash (N16)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ESP32-S3 8MB Octal PSRAM (R8 / OPI PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y

# FreeRTOS 1000Hz tick rate (1ms resolution) & task stacks
CONFIG_FREERTOS_HZ=1000
CONFIG_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# USB Host Configuration
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=512
